# http://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 2
insert_final_newline = true
max_line_length = 100
trim_trailing_whitespace = true

# `dart format` is not configurable about this: it indents with two spaces, and
# a tab landing in a Dart file is a diff the formatter undoes on the next save.
[*.dart]
indent_style = space
indent_size = 2

# `ruff format` indents with four spaces and is not configurable about it, and
# PEP 8 says the same. A tab landing in a Python file is a diff the formatter
# undoes on the next save.
[*.py]
indent_style = space
indent_size = 4

# A tab is not valid indentation in YAML at all, so this one is a syntax error
# rather than a style disagreement.
[*.{yaml,yml}]
indent_style = space
indent_size = 2
