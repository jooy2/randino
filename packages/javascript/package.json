{
	"name": "randino",
	"type": "module",
	"version": "1.3.1",
	"description": "randino generates random person names, nicknames, everyday words, whole sentences, real locations, ages, genders, fictional organizations, dates and phone numbers in the language you ask for. Nine languages, zero dependencies, ready for both Node and the browser.",
	"author": "CDGet <jooy2.contact@gmail.com>",
	"license": "MIT",
	"homepage": "https://randino.cdget.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/jooy2/randino",
		"directory": "packages/javascript"
	},
	"bugs": {
		"url": "https://github.com/jooy2/randino/issues"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"module": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"test": "tsc && node --import tsx --test \"./test/**/*.test.ts\"",
		"build": "npm run format && npm run clean && tsc && npm run minify",
		"clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
		"minify": "terser-glob 'dist/**/*.js' --config-file terser.config.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier . --write"
	},
	"keywords": [
		"random",
		"name",
		"nickname",
		"username",
		"word",
		"sentence",
		"location",
		"age",
		"gender",
		"organization",
		"date",
		"phone",
		"name-generator",
		"nickname-generator",
		"word-generator",
		"sentence-generator",
		"mock",
		"mock-data",
		"dummy",
		"fake-data",
		"test-data",
		"i18n",
		"romanize"
	],
	"devDependencies": {
		"@eslint/js": "^9.34.0",
		"@types/minimist": "^1.2.5",
		"@types/node": "^26.6.4",
		"@typescript-eslint/parser": "^8.71.1",
		"eslint": "^9.34.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-n": "^18.4.1",
		"globals": "^17.13.0",
		"jiti": "^2.7.0",
		"prettier": "^3.9.9",
		"terser-glob": "^1.2.1",
		"tsx": "^4.23.15",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.71.1"
	}
}
